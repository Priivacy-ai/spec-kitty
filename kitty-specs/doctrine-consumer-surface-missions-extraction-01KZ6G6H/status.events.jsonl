{"aggregate_id": "01KZ6G6HPTMWKK5EHGDHG9BJA5", "aggregate_type": "Mission", "event_id": "01KZ6G6JG0TJ8KAPMQMT2DA13E", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-04T13:42:51.867446+00:00", "friendly_name": "Doctrine Consumer-Surface Contract & Missions Extraction", "mission_id": "01KZ6G6HPTMWKK5EHGDHG9BJA5", "mission_number": null, "mission_slug": "doctrine-consumer-surface-missions-extraction-01KZ6G6H", "mission_type": "software-dev", "purpose_context": "Charter-sole-door (PR #3175 / #3176) closed the enumerated bypass paths around DoctrineService construction, which the project's own 3.2.x delivery plan declares as the precondition for the next step in its sequencing rule: boundary -> sole-door -> contract -> schema. This mission delivers the contract step (a real, enforced public API surface for doctrine and charter, closing the gap between the 3-name doctrine __all__ and its actual ~30-path consumer surface) and completes the missions/ tree relocation to packs/built-in that the contract step and the eventual wheel cutover both depend on knowing the shape of. The full kernel/doctrine/charter wheel publish remains explicitly deferred to a separate future mission.", "purpose_tldr": "Define and enforce a stable public API for doctrine/charter, and relocate the missions/ doctrine tree to packs/built-in \u2014 the next scoped step in the 3.2.x doctrine rework now that charter-sole-door has landed.", "target_branch": "research/doctrine-wheel-mission-types-public-api", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-08-04T13:42:52.672642+00:00"}
