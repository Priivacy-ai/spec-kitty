{"aggregate_id": "01M0CHVZPXJ2XD9M0QNT9QXME0", "aggregate_type": "Mission", "event_id": "01M0CHW0GBXEMGZC80V47AB43K", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-19T08:23:11.325955+00:00", "friendly_name": "DRG Read-Path Bridge", "mission_id": "01M0CHVZPXJ2XD9M0QNT9QXME0", "mission_number": null, "mission_slug": "drg-read-path-bridge-01M0CHVZ", "mission_type": "software-dev", "purpose_context": "An org pack authored in the canonical drg/fragment.yaml shape can declare that activating one artifact should cascade to its dependencies. Today those edges are parsed only by a separate diagnostic path and never reach charter cascade, so activating the artifact silently cascades nothing for org-authored dependencies. This mission bridges the org fragment edges into the graph charter cascade actually walks, re-scopes the graphless-pack warning to fire only when a pack ships no dependency graph at all, and flips the validator and the pinning regression test together so the tool's story stays consistent.", "purpose_tldr": "Dependency edges an org pack declares in its canonical fragment now actually drive charter cascade, instead of being read only by diagnostics.", "target_branch": "spec/charter-resolution-parity", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-08-19T08:23:12.139444+00:00"}
