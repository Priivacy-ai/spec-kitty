{"aggregate_id": "01M0CEBQM6BD3K4SS9D25PTVQB", "aggregate_type": "Mission", "event_id": "01M0CEBRDD2Y9RFAXV72XKVBK9", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-19T07:21:53.030746+00:00", "friendly_name": "Single-Authority Resolution Parity", "mission_id": "01M0CEBQM6BD3K4SS9D25PTVQB", "mission_number": null, "mission_slug": "single-authority-resolution-parity-01M0CEBQ", "mission_type": "software-dev", "purpose_context": "Today, doctrine authored in an org pack or a project overlay can silently under-load or drop out of charter activation: the loader and the activation resolver each decide independently whether to scan subdirectories, and a core kind-name mapping is hand-copied in several places where copies have drifted and fail open. This mission makes org and project doctrine load with the same completeness as the built-in corpus, has the loader and resolver agree by construction, derives the kind mapping from a single authority, and adds a guard that makes any future divergence fail loudly instead of silently, so operators can trust that what they authored is what gets activated.", "purpose_tldr": "Org and project doctrine loads as completely as built-in, so authored governance stops silently disappearing from charter activation.", "target_branch": "spec/charter-resolution-parity", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-08-19T07:21:53.837169+00:00"}
