{"aggregate_id": "01KYH7AMK2S2CQY18GE77CJEYS", "aggregate_type": "Mission", "event_id": "01KYH7ANET1T4K8G71ZBK6GRXM", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-27T07:23:45.635388+00:00", "friendly_name": "Doctrine Rule Manifests", "mission_id": "01KYH7AMK2S2CQY18GE77CJEYS", "mission_number": null, "mission_slug": "doctrine-rule-manifests-01KYH7AM", "mission_type": "software-dev", "purpose_context": "This is wave-2 mission M3 of the muster <-> spec-kitty agent-conformance programme, building on M1's conformance/ tree and CI skeleton (merged at 32722b5f1). It hand-authors SOP rule manifests under conformance/doctrine/ for the 9 trace-decidable directives plus >=4 high-value judge directives, each rule's ruleText verbatim from the directive's own integrity_rules line so muster's RULE_DRIFT lint turns upstream directive edits into visible staleness. A jq gate parses muster sop run's --json output in CI because drift findings are warnings that do not flip the exit code, and a deliberately-drifted control manifest proves the drift detector itself fires. Zero muster changes; behavioral probes are deferred to wave-2 mission M4.", "purpose_tldr": "Turn spec-kitty's built-in directives into machine-checkable SOP rule manifests that muster's RULE_DRIFT lint gates on every PR.", "target_branch": "kitty/mission-doctrine-rule-manifests", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-07-27T07:23:46.523009+00:00"}
