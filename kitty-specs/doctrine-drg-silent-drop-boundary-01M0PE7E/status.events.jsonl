{"aggregate_id": "01M0PE7E326XKYV2MCFP62X241", "aggregate_type": "Mission", "event_id": "01M0PE7FCWSPP2F0WWW7FERWE9", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-23T04:31:56.514845+00:00", "friendly_name": "Doctrine DRG Silent-Drop Boundary Fix", "mission_id": "01M0PE7E326XKYV2MCFP62X241", "mission_number": null, "mission_slug": "doctrine-drg-silent-drop-boundary-01M0PE7E", "mission_type": "software-dev", "purpose_context": "Several doctrine/DRG artifacts are authored, schema-validated, and reported healthy yet never take effect at runtime because the boundary between declaration and consumption is neither derived from a single source, fail-loud, nor test-pinned. This mission derives the DRG node-kind set from its canonical enum, makes profile context-sources and governance-profile selections either projected through DRG relationships or fail loud, and verifies a chain of organisation packs delivers every declared artifact kind.", "purpose_tldr": "Stop the doctrine/DRG system from silently dropping declared artifacts at the declaration-to-consumption boundary.", "target_branch": "fix/doctrine-drg-silent-drop-boundary", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-08-23T04:31:57.852867+00:00"}
