{"aggregate_id": "01KZ9FKGMF20FJGJ8PQEMRGSKR", "aggregate_type": "Mission", "event_id": "01KZ9FKH9GZFW4NKC0PXAM44GM", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-05T17:30:11.472375+00:00", "friendly_name": "Resolution & Activation Foundation", "mission_id": "01KZ9FKGMF20FJGJ8PQEMRGSKR", "mission_number": null, "mission_slug": "resolution-activation-foundation-01KZ9FKG", "mission_type": "software-dev", "purpose_context": "Spec Kitty is moving mission types toward being fully doctrine-provided and charter-activated, but that end state keeps being deferred because it rests on two unbuilt foundations. This mission builds them: it collapses the duplicated ways the tool locates built-in mission files into a single resolution door with consistent relocation behavior, and it makes the provisioned default charter the single source of truth for which mission types a project has, with fail-closed provisioning for both new and upgraded projects. It deliberately does not yet change which mission types are offered to users; that follow-on becomes a straightforward wiring step once these foundations exist.", "purpose_tldr": "Establish one built-in mission-tree resolution door and one authoritative mission-type activation set, so later work can offer mission types purely from the charter.", "target_branch": "feat/resolution-activation-foundation", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-08-05T17:30:12.144071+00:00"}
