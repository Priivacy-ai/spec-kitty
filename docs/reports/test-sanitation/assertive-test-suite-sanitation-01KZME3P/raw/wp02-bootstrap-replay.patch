+        _wait_timeout=5.0,
+        _poll_interval=0.02,
+    )
+
+    assert _fake_valid(recovered, _SOURCE_VERSION)
+    assert not abandoned_temp.exists()
+    assert (sentinel / "keep").read_text(encoding="utf-8") == "safe"
